    {"name":"FC Post Beijing","established_date":"2002-01-01T00:00:00","description":"Together with a group of like-mind brothers, FC Post Beijing was formed and has played in the league for more than 12 years. The international football league has become an indispensable part of our lives. We hope to keep playing and drinking together, enjoying a good game of football and then having a good time drinking beer with our brothers after the game. Enjoy the game, enjoy the process, and give it your all with the greatest respect is the way to do it!","image_url":"http://ciflchina.com/wp-content/uploads/2024/09/Screenshot-2024-10-05-at-09.43.41-300x300.png","players":[{"name":"Li Shuo","nationality":"China","position":"Goalkeeper","current_team":"FC Post Beijing","birthday":"1983-01-14T00:00:00","age":41,"player_number":7,"city":"Beijing","image_url":"https://ciflchina.com/wp-content/uploads/1983/01/WechatIMG2087-214x300.png","longitude":116.00212876382486,"latitude":40.040335488039325},{"name":"Liu Tao","nationality":"China","position":"Defender","current_team":"FC Post Beijing","birthday":"1989-04-17T00:00:00","age":35,"player_number":24,"city":"Beijing","image_url":null,"longitude":116.92603813180573,"latitude":39.84926935132506},{"name":"Wei Lei","nationality":"China","position":"Defender","current_team":"FC Post Beijing","birthday":"1987-12-28T00:00:00","age":36,"player_number":25,"city":"Beijing","image_url":"https://ciflchina.com/wp-content/uploads/1987/12/WechatIMG2092-214x300.png","longitude":115.48491745691122,"latitude":39.67644033360252},{"name":"Zhao Zhiyuan","nationality":"China","position":"Defender","current_team":"FC Post Beijing","birthday":"1999-07-23T00:00:00","age":25,"player_number":44,"city":"Beijing","image_url":null,"longitude":116.58696159161455,"latitude":40.96044064952625},{"name":"Chen Wei Lu","nationality":"China","position":"Midfielder","current_team":"FC Post Beijing","birthday":"1988-12-25T00:00:00","age":35,"player_number":27,"city":"Beij