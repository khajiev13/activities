# Copy to .env.dev (git-ignored) and chmod 600 .env.dev.
# Set APP_UID to the output of `id -u` so mode-0600 config-dev.yaml is readable.
APP_UID=1000
# Keep these equal to the corresponding values in api/config-dev.yaml.
NEO4J_PASSWORD=replace-with-neo4j-password
MINIO_ROOT_USER=replace-with-silo-admin-user
MINIO_ROOT_PASSWORD=replace-with-silo-admin-password
APP_KEY=replace-with-s3-access-key
APP_SECRET=replace-with-s3-secret-key
